# 密钥 / 环境变量（只提交 .env.example，见 config 模块）
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# 测试 / 工具缓存
.pytest_cache/
# 受限环境（沙箱）下 pytest 可能在此建临时目录且无法清理，见 docs/config-guide.md §3.2
pytest-cache-files-*/
# 手工把 TEMP 指到工作区时用的目录（见 docs/runbook/7.agents-runbook.md §11）
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 前端（第 16 步 web/）在本机受限环境下需要把三类全局目录指到工作区里，
# 它们都是**缓存/配置**，不进版本库（`web/` 自己的 .gitignore 管 node_modules/.next）：
#   .npm-cache  ← npm_config_cache（见 docs/runbook/16-web-runbook.md §1.1）
#   .npm-config ← XDG_CONFIG_HOME（npx 的配置目录）
#   .appdata    ← APPDATA/LOCALAPPDATA（create-next-app 等工具会往这里写）
.npm-cache/
.npm-config/
.appdata/
# uv 的缓存也常被指到工作区（前几步的 runbook 都这么写）
.uv-cache/
# HuggingFace 模型缓存（本地 embedding 后端用它）。
# 默认写在 ~/.cache/huggingface —— 受限环境下**仓库外不可写**，必须用
#   $env:HF_HOME="$PWD\.hf-cache"
# 指到工作区；见 docs/环境迁移验收.md §1.2。
.hf-cache/
