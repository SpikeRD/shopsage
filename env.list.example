# ─────────────────────────────────────────────────────────────────────────────
# ShopSage 容器环境变量清单（**Linux + Docker 全栈部署用**）
#
# 用法：
#   cp env.list.example env.list      # 只做一次
#   vi env.list                       # 填真实值（密钥！）
#   chmod 600 env.list                # ⚠️ 里面全是密钥，别让同机其他用户读到
#
# 被谁读：`docker-compose.yml` 的 `env_file: - env.list`（api / worker / migrate / postgres）。
# 传给容器的方式是 **进程环境变量**，所以 pydantic Settings 的优先级链
# 「环境变量 > .env > 代码默认值」到这里就只剩第一档 —— 容器里根本没有 .env（
# `.dockerignore` 把它排除了），这正是 `2.infra.md` §5 的设计。
#
# ⚠️ 三条硬规则（每条都对应一次实测踩过的故障）：
#
#   ① **KEY=VALUE 一行一个，值里不要写注释**。`LLM_PRIMARY=xxx   # 说明` 会把注释
#      整段算进值里（`.env.example` 里为此专门写过一条警告）。
#   ② **值里不要加引号**。env_file 的解析不剥引号（与 shell 不同），
#      `POSTGRES_PASSWORD="abc"` 会让密码真的带上两个引号。
#   ③ **别在这里放 `#` 开头的行当「行内说明」** —— 整行注释是安全的，行内不是。
#
# ⚠️ 与仓库根 `.env` 的关系：**两份文件、两个消费者**，不要互相 include。
#   · `.env`      → 开发机（Windows）的业务进程 + 开发 compose（infra/docker-compose.dev.yml）
#   · `env.list`  → Linux 上的全栈容器（本文件）
#   开发期那份不参与生产，生产这份不进 Git（见 .gitignore）。
# ─────────────────────────────────────────────────────────────────────────────

# ═══ 1. 环境开关 ══════════════════════════════════════════════════════════════
# ⚠️ docker-compose.yml 的 `environment:` 里已强制 ENV=prod（那里的优先级更高）。
#    这里写一遍是为了「单独 docker run 这个镜像」时也是 prod —— 两处一致最安全。
# prod 会触发两条 fail-fast（app/config/settings.py::_validate_prod_requirements）：
#   缺 DATABASE_URL 或 LLM_API_KEY → 拒绝启动（而不是跑到第一个请求才 500）。
ENV=prod
TZ=Asia/Shanghai

# ═══ 2. 数据库与缓存 ═════════════════════════════════════════════════════════
# ⚠️ host 必须是 **compose 服务名**（postgres / redis），不是 localhost、也不是服务器 IP：
#    容器里的 localhost 是容器自己。
#
# 🕳️ 坑（2026-10 实测）：把 host 写成 IP（例如从 `docker ps` 抄来的 172.18.x.x）会得到
#    「有时能连、重建容器后突然连不上」的诡异症状：
#      psycopg.OperationalError: connection failed: connection to server at "172.18.142.64",
#        port 5432 failed: server closed the connection unexpectedly
#    原因不是数据库坏了（它 `healthy`、`restarts=0`），而是 **IP 被写死在配置里**：
#      · 容器重建 → Docker 把网络里的 IP 重新分配给别的容器 → 这个地址指向了别人；
#      · 而写 IP 时**不经过 Docker 内嵌 DNS**，服务名解析根本没参与。
#    判据（两者不一致就是它）：
#      docker compose ... run --rm --no-deps --entrypoint sh api -c 'getent hosts postgres'
#      docker compose ... run --rm --no-deps --entrypoint sh api -c 'printenv DATABASE_URL'
#    ⚠️ 永远不要往这里填 IP，哪怕「刚才 `docker inspect` 看到的就是这个」。
POSTGRES_USER=shopuser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=shopsage

# ⚠️ 「两套消费者」在这里合并成一条：POSTGRES_* 给 postgres 容器初始化，
#    DATABASE_URL 给应用建连接 —— 两者的 user/password/db **必须完全一致**。
#    ⚠️ POSTGRES_PASSWORD 只在**数据卷为空**时生效一次：卷已存在时改它不会改库里的口令
#    （要么进库 ALTER USER，要么 down -v 清空重建）。见 runbook §6.2。
DATABASE_URL=postgresql://shopuser:change-me-strong-password@postgres:5432/shopsage

# 只读 DSN（第 4 步 security）：Text-to-SQL 的读路径只走它。
# 角色由 `docker compose run --rm api python -m scripts.db_readonly` 创建；
# 口令来自本文件的环境变量 SHOPSAGE_READONLY_PASSWORD（见 §7 初始化顺序）。
# 留空 = 读路径回落 DATABASE_URL（此时「只读」只在命名上成立）。
DATABASE_READ_URL=postgresql://shopsage_readonly:change-me-readonly-password@postgres:5432/shopsage

# ⚠️ 无凭据形式：compose 里 redis 的启动参数是 `redis-server --appendonly yes`，
#    **没有 --requirepass**，所以 Redis 不接受密码 —— 写成 redis://:pass@redis:6379/0 反而连不上。
#    同样**不要**写 IP（理由见上面那个坑）。
REDIS_URL=redis://redis:6379/0

# checkpoint 后端：memory / postgres / redis（默认 memory）
# ⚠️ 生产**必须** postgres：memory 意味着进程重启即丢会话（且多副本各存一份）。
# redis 后端需要 RediSearch + RedisJSON 模块，本仓的 redis:7-alpine **没有**。
CHECKPOINT_BACKEND=postgres

# ═══ 3. 鉴权 ═════════════════════════════════════════════════════════════════
# ⚠️ ENV=prod 缺失 → **拒绝启动**（app/security/auth.py::_ensure_usable）。
#    少于 16 字符同样拒绝（HS256 的强度直接由密钥长度决定）。
# 生成：openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# 演示账号（admin / 13800000002 / 13800000003 / employee）。
# ⚠️ 生产建议 false：账号由管理员在管理台创建。
ACCOUNT_SEED_ENABLED=false

# ═══ 4. LLM（主 + 备 + embedding）═══════════════════════════════════════════
LLM_PRIMARY=deepseek/deepseek-flash
LLM_API_KEY=sk-replace-me
# 降级模型必须用自己的密钥（跨厂商时拿主密钥打备用端点必然 401）。
# ENV=prod 下「配了 LLM_FALLBACK 却没有 LLM_FALLBACK_API_KEY」→ 拒绝启动。
LLM_FALLBACK=dashscope/qwen3.7-flash
LLM_FALLBACK_API_KEY=sk-replace-me-fallback
# 仅当备模型走 OpenAI 兼容网关/自建代理时才需要
# LLM_FALLBACK_API_BASE=https://api.openai.com/v1

# 向量化后端：litellm（调 API）| local（本地 sentence-transformers）
#
# ⚠️⚠️ **这里的默认值不是随便挑的，它被两处硬约束锁住**：
#   ① 迁移 `20261010_a1f0c3d5b7e9_add_rag_vector_tables.py` 把建表维度**写死成
#      `vector(1024)`**（`app/rag/schema.py::VECTOR_DIM` 与它有测试对账）；
#   ② `EMBEDDING_DIM` / `RAG_VECTOR_DIM` 都必须等于它，否则：写库报维度错（好一些），
#      或者维度恰好相同但向量空间不相容 → 检索静默返回垃圾（最坏）。
#
# ── 默认：litellm + 阿里云百炼 qwen3.7-text-embedding-flash（1024 维）────────────
# 为什么不再是 local：镜像里不必装 torch（省 2 GB），且本机/小机器内存够用。
# 实测三条（2026-10，真的跑过）：
#   ① 输出 **1024 维**，**与迁移的 vector(1024) 完全一致** → 不需要改任何迁移；
#   ② 单次批量上限 **25 条**（32 条 → 400 InvalidParameter），
#      故 `app/rag/ingest.py` 的 EMBED_BATCH=16（留一档余量）；
#   ③ 0.125 元/百万 token，8 份语料灌一次不到 1 分钱。
# 代价：文本出网（走阿里云）。合规不许出网时再切回 local。
# ⚠️ 切回 local 就必须用 `--build-arg WITH_LOCAL_EMBEDDING=true` 构建镜像，
#    否则镜像里没有 sentence-transformers：服务能起来、/health 全绿，
#    直到**第一次检索**才失败（症状是「回答没有依据」，看起来像模型答得不好）。
EMBEDDING_BACKEND=litellm
# ⚠️ `dashscope/` 是 litellm 的路由前缀，**不能省**（省了会按 openai 处理 → 404/401）
EMBEDDING_MODEL=dashscope/qwen3.7-text-embedding-flash
# ⚠️⚠️ **必须单独填**：留空会回落复用 LLM_API_KEY，而那是 DeepSeek 的 key ——
#    打 dashscope 端点必然 401（实测 AuthenticationError: invalid_api_key）。
#    填阿里云百炼的 key（可与 LLM_FALLBACK_API_KEY 同一把）。
EMBEDDING_API_KEY=
# 期望维度：>0 时实际维度不符直接报错（防「换了模型后静默写废向量库」）
# qwen3.7-text-embedding-flash=1024（可选 256/512/768/1024）；bge-m3=1024；
# ⚠️ text-embedding-3-small=1536，与本仓迁移**不兼容**（要换得改迁移 + 重灌向量）
EMBEDDING_DIM=1024
# 仅 local 后端用（模型权重落在挂载的 hf_cache 卷里，容器重建不重下）
# EMBEDDING_DEVICE=cpu

# ═══ 5. RAG 检索层 ═══════════════════════════════════════════════════════════
# ⚠️ RAG_VECTOR_DIM 必须与 EMBEDDING_DIM、以及迁移里 rag_chunks.embedding 的
#    vector(n) 三者一致。不一致的症状是「检索看着正常、结果全是乱的」。
RAG_VECTOR_DIM=1024
# rerank：off | local | api。local 需要 WITH_LOCAL_EMBEDDING=true（torch）
# 默认 off：先让链路跑通。打开 local 会多下载一个 CrossEncoder（bge-reranker-base ~1 GB）
# 生产可以保持 off：rerank 的收益是「上下文更短」（省 token），代价是一次额外模型调用
RAG_RERANK=off
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_CANDIDATES=30
RAG_RRF_K=60
RAG_KEYWORD_MIN_RATIO=0.6
RAG_BM25_K1=1.2
RAG_BM25_B=0.75
RAG_MAX_TOP_K=20
RAG_CHUNK_MAX_CHARS=600
RAG_CHUNK_OVERLAP=80
# ⚠️ **语料目录不可配置**，刻意不提供变量：
#    `app/rag/settings.py::RagSettings` 的 `knowledge_dir` 默认值就是 `docs/kb`，
#    而 `Settings` 里**没有** `knowledge_dir` 字段（实测 `KNOWLEDGE_DIR=...` 会被忽略，
#    因为 pydantic 的 extra="allow" 并不会把任意额外键变成可读属性）。
#    容器里的 `/app/docs/kb` 由 Dockerfile 的 `COPY docs/kb ./docs/kb` 提供。
#    真要换目录，得改 `RagSettings` 或 `scripts.load_knowledge_base --root`。

# ═══ 6. API 行为 ═════════════════════════════════════════════════════════════
API_PREFIX=/api
# 生产**必须显式列出前端来源**（留空且 ENV=prod 时白名单为空 = 不允许任何跨源）。
# ⚠️ 不能写 `*`（启动即拒）。同源部署（反代把页面与 /api 放同一个域）时这一项可以留空。
API_CORS_ORIGINS=https://shopsage.example.com
# 内部结构（visited / sql / guardrail_rules）不进响应
API_DEBUG_PAYLOAD=false
# 限流额度：`次数/窗口秒`
RATE_LIMIT_CHAT=30/60
RATE_LIMIT_CHAT_STREAM=60/60

# ═══ 7. 口令（初始化脚本用，不是应用配置）═══════════════════════════════════
# `scripts.db_readonly` 从这里读出只读角色口令（口令不进 Git、不进命令行参数）。
# ⚠️ 必须与上面 DATABASE_READ_URL 里的口令一致，否则读路径认证失败。
SHOPSAGE_READONLY_PASSWORD=change-me-readonly-password

# ═══ 8. 可观测 ═══════════════════════════════════════════════════════════════
OBSERVABILITY_ENABLED=true
# 服务名由 docker-compose.yml 按角色覆盖（api / worker 各一个），这里只是兜底。
SERVICE_NAME=shopsage-api
# ⚠️ OTLP/**HTTP** 是 4318；4317 是 gRPC。写 4317 不会报错，只是 trace 一条都不到
#    （app/observability/tracing.py 会把它变成启动期 WARNING）。
#
# ⚠️⚠️ **默认留空**，因为 collector 是 profile 门控的（默认不起）：
#    配了地址却没起 collector 时，业务侧的 BatchSpanProcessor 会**不断重试连接**
#    （只打日志、不阻塞请求，但日志会变吵、且容器退出时 flush 会拖时间）。
#    要开 trace 就两步一起做：
#      docker compose -f docker-compose.yml --project-directory . --profile tracing up -d otel-collector
#      然后把下面这行取消注释：
# OTEL_ENDPOINT=http://otel-collector:4318
# Langfuse：两个键都填才启用；留空 = 完全不构造 client（零网络、零后台线程）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 自建 Langfuse 的地址（留空 = Langfuse Cloud）
LANGFUSE_HOST=
LANGFUSE_ENABLED=true

# ═══ 9. MCP（python -m app.mcp，可选）════════════════════════════════════════
# internal = 只暴露内部工具；customer = 只暴露对客工具（此时必须给 MCP_ACTOR_USER_ID）
MCP_POLICY=internal

# ═══ 10. Grafana（只被 grafana 容器读取）═════════════════════════════════════
# ⚠️ Grafana 认 `GF_<SECTION>_<KEY>` 形式的变量（这里是 security.admin_*）。
#    开发栈（infra/docker-compose.dev.yml）用的是 GRAFANA_ADMIN_USER 这种「自定义名 +
#    compose 插值」的写法 —— 生产这里直接用 GF_，省掉一层插值，值只来自本文件。
# ⚠️ 首次启动后改这里**不会**改已有的 admin 口令：它只在 grafana_data 卷为空时生效
#    （与 POSTGRES_PASSWORD 同一个坑）。卷已存在时要进 UI 改，或 `docker exec` 用
#    grafana-cli 重置。
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin
