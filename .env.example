# 复制为 .env 并按需填写；.env 不入 Git（见 .gitignore）。
# 加载优先级：进程环境变量 > .env > 代码默认值。
#
# ⚠️ 优先级意味着：Windows 用户级环境变量（setx / 「系统属性 → 环境变量」里配的）
#    会**覆盖**下面同名的项。项目不做任何环境变量清理，改为启动时自动告警：
#      配置冲突：进程环境变量 DATABASE_URL 正在覆盖 .env 中的同名值（生效值: ...）
#    看到这条就说明该字段以环境变量为准，.env 里的值不生效。
#
# 查看本机有哪些变量（只列名字，不打印值 —— 避免密钥进日志/截图/聊天记录）：
#   全部用户级变量名（PowerShell，含 BOM 时可直接复制到终端；无 BOM 则先执行一次
#   [Console]::OutputEncoding=[Text.Encoding]::UTF8）：
#     [Environment]::GetEnvironmentVariables('User').Keys | Sort-Object
#   只看会与本文件下方各项冲突的名字：
#     'DATABASE_URL','REDIS_URL','LLM_API_KEY','ENV','OTEL_ENDPOINT','LANGFUSE_PUBLIC_KEY','LANGFUSE_SECRET_KEY' |
#       Where-Object { [Environment]::GetEnvironmentVariable($_,'User') -or [Environment]::GetEnvironmentVariable($_,'Machine') }

# 环境开关：dev | prod
ENV=dev

# 数据库 / 缓存
#
# ⚠️ 本机（VMware-Windows）没有 Docker：依赖服务跑在 VMware-Linux 虚拟机里
#    （见 infra/docker-compose.dev.yml）。所以这里的 host 必须是【Linux 虚拟机的 IP】，
#    写 localhost 连不上。查 IP：在 Linux 里执行 `ip -4 addr show`。
#
# 下面两组是「两套消费者」，改凭据/端口时必须同时改，否则应用连不上库：
#   ① POSTGRES_* / REDIS_*  → 被 docker compose 读取，用于【初始化容器 + 端口映射】
#   ② DATABASE_URL / REDIS_URL → 被应用（pydantic Settings）读取，用于【建立连接】
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 想让数据库只对 VMware 网段开放时，设成 Linux 虚拟机自己的 IP；留空 = 0.0.0.0（省事）
# POSTGRES_BIND_IP=192.168.x.x

DATABASE_URL=postgresql://shopuser:shoppass@192.168.x.x:5432/shopsage
# 只读 DSN（第 4 步 security）：Text-to-SQL 的读路径只走它 —— 即使 SQL 校验被绕过，
# 写操作也会在数据库层报权限错误（纵深防御）。留空 = 读路径回落 DATABASE_URL，
# 此时「只读」只在命名上成立（见 docs/runbook/3.db-runbook.md §5.3）。
# 角色与授权由 `uv run python -m scripts.db_readonly` 创建（口令从环境变量读，不进 Git）。
DATABASE_READ_URL=postgresql://shopsage_readonly:<只读口令>@192.168.x.x:5432/shopsage
REDIS_URL=redis://192.168.x.x:6379/0

# 鉴权（第 4 步 security）：JWT 签名密钥。
# ⚠️ ENV=prod 时缺失会拒绝启动（不允许静默使用开发默认密钥）；生成：openssl rand -hex 32
JWT_SECRET=

# 演示账号（变更 001）：`scripts/seed.py` 是否灌「可登录的演示账号」。
#   true（默认）→ 灌 4 个：admin / 13800000002 / 13800000003 / employee
#                 （两个客户是给限流演示用的 —— 桶键里带主体，一个客户演示不出「各有一份额度」）
#   口令写在 scripts/seed.py 的 `DEMO_ACCOUNTS` 里，**刻意不打印到终端**
#   （口令一旦落到终端输出/日志/截图里就等价于泄露了；理由见 seed.py 的 `_seed_accounts` 注释）
#   false        → 不灌。**生产部署建议关掉**：账号只能由管理员在管理后台开。
# 注意：这只控制「种子脚本要不要建演示账号」，与登录接口本身无关。
ACCOUNT_SEED_ENABLED=true

# ⚠️ 令牌有效期**目前不是环境变量**：它是 `app/security/auth.py` 的常量
# （`DEFAULT_TTL_SECONDS = 30 分钟`、`DEFAULT_REFRESH_TTL_SECONDS = 14 天`）。
# 刻意不放进 `.env`：有效期是**安全参数**，改它应当走一次代码变更 + review，
# 而不是「某台机器上的 .env 里写了个别的值」——那种差异在排障时根本看不出来。
# 要调：改 `auth.py` 的两个常量（并同步本文件与 `docs/modules/4.security.md`）。

# Grafana 开发账号（浏览器开 http://<Linux-IP>:3000，开发期已开匿名只读）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# LLM（多模型路由：主 + 备）
LLM_PRIMARY=deepseek/deepseek-flash
LLM_API_KEY=sk-your-key

# ⚠️ 降级模型用【单独】的密钥，不要复用 LLM_API_KEY（docs/runbook/5.llm-runbook.md §1.2.1）：
#    降级链天生是跨厂商的（主 DeepSeek / 备 OpenAI 之类），拿 A 家的 key 打 B 家的端点必然 401；
#    而降级发生的时刻正是主模型已经不可用的时候，此刻失败 = 直接对用户报错。
#    单独一把钥匙另外带来：故障隔离（主 key 被限流/超额时备路径仍可用）、独立轮换、账单可归属。
#    留空 = 本步不启用降级；一旦填了 LLM_FALLBACK，就把对应的 key 一起填上。
#    ENV=prod 下「配了 fallback 却没有 fallback key」会拒绝启动（dev 只告警）。
LLM_FALLBACK=
LLM_FALLBACK_API_KEY=
# 仅当备模型走 OpenAI 兼容网关/自建代理时才需要（留空即用该模型默认端点）
# LLM_FALLBACK_API_BASE=https://api.openai.com/v1

# 向量化（第 5 步 llm 的 embed() 用；第 10 步 rag 检索、第 13 步 cache 判相似都走它）。
# ⚠️ 与 LLM_PRIMARY 分开配置：embedding 端点常常不是同一个厂商/模型族。
#
# 两种后端选一种（接口完全一样，调用方不感知差异）：
#   litellm = 调 API：按 token 计费、文本出网、可能 429/超时（可重试）
#   local   = 本地 sentence-transformers：零边际成本、文本不出网、吃本机 CPU/内存
#             需要可选依赖 `uv sync --extra local`（含 torch，约 2 GB）
#             选它的正当理由只有三条：合规不许出网 / 完全离线 / 调用量极大且成本敏感
# ⚠️ 取值行只写「键=值」，注释一律单独成行 —— 这样整段复制粘贴到 .env 也绝不会把说明文字
#    抄进值里（实测踩过：模型名后面跟了说明文字 → 变成 `BAAI/bge-m3    # ...`，
#    于是本地后端拿着一个不存在的仓库名去 HuggingFace，报 401/404）。
#
# ── 默认推荐：litellm + 阿里云百炼 qwen3.7-text-embedding-flash ────────────────
# 三条实测结论（2026-10，真的跑过，不是抄文档）：
#   ① 输出 **1024 维**，与迁移里写死的 vector(1024) **一致** → 不需要改迁移；
#   ② 单次批量上限 **25 条**（32 条返回 400 InvalidParameter），
#      所以 app/rag/ingest.py 的 EMBED_BATCH 定在 16；
#   ③ 价格 0.125 元/百万 token —— 8 份语料（约 3.6K token）灌一次不到 1 分钱。
# 选它的正当理由：不想装 torch（省 2 GB 镜像、省内存），且能接受文本出网。
EMBEDDING_BACKEND=litellm
# litellm 后端填模型名，**必须带 provider 前缀**（`dashscope/` 是 litellm 的路由标记，
# 省了会按 openai 处理 → 404/401）；local 后端填 HuggingFace 仓库名或本地目录（如 BAAI/bge-m3）
EMBEDDING_MODEL=dashscope/qwen3.7-text-embedding-flash
# ⚠️⚠️ **embedding 与主模型不同厂商时必须单独填**：
#    留空会回落复用 LLM_API_KEY，而那是 DeepSeek 的 key —— 打 dashscope 端点必然 401
#    （实测 AuthenticationError: invalid_api_key）。填阿里云百炼的 key。
EMBEDDING_API_KEY=
# 期望向量维度：>0 时实际维度不符【直接报错】。建议填真值 —— 防「换了模型/后端后维度变了」静默写废向量库。
# 取值方法见 docs/runbook/5.llm-runbook.md §7.6
# qwen3.7-text-embedding-flash = 1024（可选 256/512/768/1024）；bge-m3 = 1024；
# ⚠️ text-embedding-3-small = 1536，与本仓迁移的 vector(1024) 不兼容，要换得改迁移
EMBEDDING_DIM=1024
# 仅 local 后端用：离线环境指向本地模型目录；device 写 cpu 最稳（避免无 CUDA 机器上刷 warning）
# EMBEDDING_LOCAL_PATH=/path/to/bge-m3
# EMBEDDING_DEVICE=cpu

# ⚠️ 把 `EMBEDDING_BACKEND` 改成 `local` 是**换后端**，不是「换个模型名」：
#    · 它需要可选依赖 `uv sync --extra local`（含 torch，约 2 GB）；没装就调不通；
#    · 第一次调用会去 HuggingFace 下权重，离线/无凭证环境会报 401/404；
#    · 向量维度与向量空间都会变（bge-m3 = 1024），必须同步改 EMBEDDING_DIM、10.rag 的 vector(n)
#      并重灌全部向量。
#    只是想换个 API 模型名时，**后端保持 litellm**，只改 EMBEDDING_MODEL。
#
# ⚠️ **任何 embedding 变更（换模型/换后端/换维度）都是「换向量空间」**：
#    旧向量与新模型的坐标系完全不相容，不能混用、不能"压缩"。必须：
#      ① 清空 rag_chunks / cache_semantic_entries；
#      ② 确认 EMBEDDING_DIM = RAG_VECTOR_DIM = 迁移里的 vector(n)；
#      ③ 重新灌库（`python -m scripts.load_knowledge_base`）。
#    漏掉 ① 的症状最阴：检索不报错，但返回的结果与问题无关（旧向量还在库里被召回）。

# ── RAG 检索层（第 10 步 rag）─────────────────────────────────────────────────
# ⚠️ RAG_VECTOR_DIM 必须与本项目向量表 `rag_chunks.embedding vector(n)` 的 n 一致，
#    也要与上面 EMBEDDING_DIM 一致。三者不一致时的症状是「检索看着正常、结果全是乱的」
#    （维度相同但向量空间不相容），所以启动/建表时都会校验，见 docs/runbook/10.rag-runbook.md §2。
#    0 = 只跑不碰库的逻辑单测时用；接库请填真值（bge-m3 = 1024）。
RAG_VECTOR_DIM=0
# 混合检索：初召回（向量腿 + 关键词腿各取多少条）→ RRF 融合 → rerank → 只把 top-k 送 LLM（E2）。
RAG_CANDIDATES=30
# RRF 的 k（1/(k+rank)）：60 是经典经验值，越大越"平权"两路召回
RAG_RRF_K=60
# 关键词腿的覆盖率门槛与 BM25 参数（改这两个等于改召回率/精确率的取舍）
RAG_KEYWORD_MIN_RATIO=0.6
RAG_BM25_K1=1.2
RAG_BM25_B=0.75
# rerank 后端：off（关掉，评测对照用）| local（本地 CrossEncoder）| api（兼容 /rerank 的 HTTP 端点）
# ⚠️ 默认 off：`local` 需要 sentence-transformers（torch，~2 GB）——
#    选了 litellm embedding 却开 local rerank，等于「为省内存而换 API，又为 rerank 装回 torch」。
#    rerank 的收益是「送进 LLM 的上下文更短」（实测候选池 → top-5 压缩 -73%）；
#    内存充裕的服务器上可以打开它（本仓 2026-10 在本机改为 off 就是这条理由）。
RAG_RERANK=off
RAG_RERANK_MODEL=BAAI/bge-reranker-base
# 仅 api 后端用
# RAG_RERANK_API_BASE=
# RAG_RERANK_API_KEY=
# 对客 top-k 的硬上限（LLM 要「Top 500」时由它兜底）
RAG_MAX_TOP_K=20
# 分块：max_chars 是硬上限，overlap 是相邻块的重叠字符数（防答案被切在缝上）
RAG_CHUNK_MAX_CHARS=600
RAG_CHUNK_OVERLAP=80

# ── 第 16 步 web（前端）的跨源白名单 ─────────────────────────────────────────
# 前端（Next，默认 http://127.0.0.1:3000）与 API **不同源**（端口不同就是不同源），
# 浏览器读跨源响应要求后端回 `Access-Control-Allow-Origin` —— 所以第 16 步给 API 加了 CORS 中间件。
# 下面这项是它的白名单；留空 = 开发期默认放通 localhost:3000 与 127.0.0.1:3000。
#
# ⚠️ 三条实测经验（见 docs/runbook/16-web-runbook.md §10.1 坑 11）：
#   ① `localhost` 与 `127.0.0.1` 是**两个不同的来源**，只配一个的症状是「换个地址打开就坏」；
#   ② 这项里**不能写 `*`**（写了启动即拒）：CORS 是「哪些站点能从浏览器读这个 API」的边界，应显式可审计；
#   ③ **CORS 不是鉴权**：它只约束浏览器，curl/脚本不受影响 —— 真正的门仍是 `Authorization: Bearer <JWT>`。
# 排查「页面报 Failed to fetch 而服务端日志是 200」用：uv run python -m scripts.check_web_cors
# API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 可观测（第 11 步 observability：OTEL + Prometheus + Langfuse）─────────────
# ⚠️ 默认**留空**：空 = span 只留在进程内存里（开发默认：不建 exporter、不重试、无后台噪音）。
#    要外发就起 collector 再填地址：
#      docker compose -f infra/docker-compose.dev.yml --project-directory . up -d otel-collector
#    填的时候**必须是 OTLP/HTTP 的 4318**（4317 是 gRPC）：
#      OTEL_ENDPOINT=http://192.168.1.6:4318
#    配成 4317 或写错端口的后果**不是报错**，而是 trace 一条都不到 ——
#    `app/observability/tracing.py` 会把 4317 变成一条启动期 WARNING（能照着改）。
OTEL_ENDPOINT=
# 三件套总开关：false = 所有埋点退化成 no-op（压测对照 / 「怀疑监控拖慢业务」时用）
OBSERVABILITY_ENABLED=true
# 进 OTEL resource 与日志的服务名（多服务共用一个 collector 时靠它区分）
SERVICE_NAME=shopsage-api
# Langfuse：**两个键都填了才启用**；留空 = 完全不构造 client（零网络请求、零后台线程）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 自建 Langfuse 的地址（留空 = SDK 默认，即 Langfuse Cloud）
LANGFUSE_HOST=
# ⚠️ 即使密钥配好了也能用这个开关关掉上报。它的存在理由：Langfuse SDK 注册了
#    atexit 钩子，进程退出时 flush —— 实测（端点不可达）最短 2.0s、最长 23.6s，
#    记过 score 之后 6~13s。压测/演示/临时排障时不想付这个代价就设 false。
LANGFUSE_ENABLED=true
